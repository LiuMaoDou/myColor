{
  "name": "color-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3017",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3017",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx scripts/setup.ts",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose stop",
    "test:e2e": "playwright test",
    "setup": "node scripts/bootstrap.mjs",
    "format:check": "prettier --check app components lib server scripts tests next.config.ts playwright.config.ts vitest.config.mts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "4.0.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.7",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/culori": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
